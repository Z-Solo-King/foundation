{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heroic-ai.dev/schema/chatbot-run-record/v1",
  "title": "chatbot-run-record v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "chatbot-run/v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string"
    },
    "status": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "created_at",
    "status"
  ]
}
