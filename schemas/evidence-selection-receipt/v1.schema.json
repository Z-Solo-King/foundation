{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heroic-ai.dev/schema/evidence-selection-receipt/v1",
  "title": "evidence-selection-receipt v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "evidence-selection-receipt/v1"
    },
    "run_id": {
      "type": "string"
    },
    "selected_method": {
      "type": "string"
    },
    "evidence_class": {
      "type": "string"
    },
    "source_count": {
      "type": "integer",
      "minimum": 0
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "selected_method",
    "evidence_class"
  ]
}
