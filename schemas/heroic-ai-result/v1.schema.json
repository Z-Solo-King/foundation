{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://heroic-ai.dev/schema/heroic-ai-result/v1",
  "title": "heroic-ai-result v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "heroic-ai-result/v1"
    },
    "status": {
      "type": "string",
      "enum": [
        "COMPLETED",
        "PARTIAL",
        "BLOCKED",
        "FAILED"
      ]
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "response": {
      "type": [
        "object",
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string"
    }
  },
  "required": [
    "schema_version",
    "status",
    "run_id"
  ]
}
