{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Heroic AI Agent Benchmark Observation Envelope",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "provider",
    "model",
    "agent_role",
    "lane",
    "task_id",
    "fixture_version",
    "repository_revision",
    "tool_policy_version",
    "evidence_tier",
    "observation"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "heroic-ai-agent-benchmark-observation/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "agent_role": {"enum": ["main", "explorer", "worker", "researcher", "advisor"]},
    "lane": {"enum": ["A", "B", "C", "D", "E", "F"]},
    "task_id": {"type": "string", "minLength": 1},
    "language_lens": {"type": "string", "minLength": 1},
    "fixture_version": {"type": "string", "minLength": 1},
    "repository_revision": {"type": "string", "minLength": 1},
    "tool_policy_version": {"type": "string", "minLength": 1},
    "evidence_tier": {"type": "string", "minLength": 1},
    "artifact_digest": {"type": "string", "minLength": 1},
    "observation": {"type": "object"}
  }
}
