{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Decision Fork Benchmark Observation",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "task_id",
    "trajectory_id",
    "fork_id",
    "state_digest",
    "decision_type",
    "candidates",
    "chosen_candidate",
    "outcome_visible_to_decider",
    "hindsight_best_candidate",
    "provider",
    "model",
    "decision_latency_ms",
    "decision_calls",
    "evidence_class"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"type": "string", "const": "decision-fork-observation/v1"},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "trajectory_id": {"type": "string", "minLength": 1},
    "fork_id": {"type": "string", "minLength": 1},
    "repeat_group": {"type": "string", "minLength": 1},
    "state_digest": {"type": "string", "minLength": 1},
    "decision_type": {
      "type": "string",
      "enum": [
        "route",
        "tool",
        "context",
        "recovery",
        "continue",
        "stop",
        "migration",
        "candidate"
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 2,
      "items": {"type": "string", "minLength": 1}
    },
    "chosen_candidate": {"type": "string", "minLength": 1},
    "hindsight_best_candidate": {"type": "string", "minLength": 1},
    "outcome_visible_to_decider": {"type": "boolean", "const": false},
    "provider": {"type": "string", "minLength": 1},
    "model": {"type": "string", "minLength": 1},
    "decision_latency_ms": {"type": "number", "minimum": 0},
    "decision_calls": {"type": "integer", "minimum": 1},
    "decision_input_tokens": {"type": "integer", "minimum": 0},
    "decision_output_tokens": {"type": "integer", "minimum": 0},
    "evidence_class": {"type": "string", "const": "benchmark-observation"}
  }
}
