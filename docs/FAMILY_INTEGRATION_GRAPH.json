{
  "schema": "family-integration-graph/v1",
  "version": "1.2",
  "status": "CURRENT",
  "purpose": "Cross-surface integration map for Foundation + Operations. Links docs, AI navigation, research, benchmark, extractor/mapper, chatbot, UI, persistence, runtime, resource, security and observability without creating new authority.",
  "hard_rules": [
    "one canonical owner per behavior",
    "foundation public contracts/core -> operations consumer",
    "Operations remains private runtime/control-plane authority and does not gain GitHub Actions or competing deployment authority",
    "research-signal evidence cannot certify runtime/production behavior",
    "model confidence, popularity or benchmark scores cannot override security/policy/provenance/resource/recovery/deployment gates"
  ],
  "nodes": [
    {
      "id": "foundation.docs",
      "repo": "foundation",
      "role": "public contracts/current-state docs",
      "paths": [
        "docs/FAMILY_CONTRACT.json",
        "docs/FAMILY_ARCHITECTURE.md",
        "docs/FAMILY_SYNC_STANDARD.md",
        "docs/CURRENT_SOURCE_OF_TRUTH.md"
      ]
    },
    {
      "id": "foundation.ai_map",
      "repo": "foundation",
      "role": "AI navigation",
      "paths": [
        "docs/AI_ANALYSIS_MAP.md",
        "REPOSITORY_MAP.json"
      ]
    },
    {
      "id": "foundation.research",
      "repo": "foundation",
      "role": "deterministic research planning/evidence",
      "paths": [
        "backend/intelligence/knowledge.py",
        "backend/intelligence/contracts.py",
        "backend/intelligence/planning.py",
        "benchmark/chatbot_query_benchmark.py"
      ]
    },
    {
      "id": "foundation.benchmark",
      "repo": "foundation",
      "role": "agent/research benchmark",
      "paths": [
        "benchmark/ai_agent_benchmark_contract.py",
        "benchmark/ai_agent_task_matrix_v1.json",
        "benchmark/decision_fork_schema.json",
        "benchmark/public_chatbot_runner.py",
        ".github/workflows/nightly-ai-research-20jobs.yml"
      ]
    },
    {
      "id": "foundation.edge",
      "repo": "foundation",
      "role": "public Worker/API boundary",
      "paths": [
        "polyglot/edge-worker/src/router.ts",
        "polyglot/edge-worker/src/contracts.ts",
        "worker.py"
      ]
    },
    {
      "id": "foundation.ui",
      "repo": "foundation",
      "role": "UI state/composer/chat/research lifecycle",
      "paths": [
        "frontend/index.html",
        "frontend/app.js",
        "frontend/frontend_state.js",
        "frontend/chat_store.js",
        "frontend/chat_view.js",
        "frontend/workspace_view.js",
        "frontend/lifecycle_controller.js",
        "frontend/ui_contract_test.mjs"
      ]
    },
    {
      "id": "foundation.persistence",
      "repo": "foundation",
      "role": "public persistence/lineage structures",
      "paths": [
        "backend/persistence/d1.py",
        "backend/run_record.py",
        "backend/artifacts/manifest.py"
      ]
    },
    {
      "id": "operations.extractor_mapper",
      "repo": "operations",
      "role": "acquisition/extraction/mapping/adapters",
      "paths": [
        "extractor_mapper/contracts.py",
        "extractor_mapper/observation_contract.py",
        "extractor_mapper/mapping/product.py",
        "extractor_mapper/adapters/platforms.py"
      ]
    },
    {
      "id": "operations.chatbot",
      "repo": "operations",
      "role": "private chat routing/provider/idempotency/streaming",
      "paths": [
        "private/chatbot/chat_endpoint.py",
        "private/chatbot/provider_stream.py",
        "private/chatbot/provider_response_contract.py",
        "private/chatbot/streaming.py",
        "private/chatbot/idempotency.py"
      ]
    },
    {
      "id": "operations.resource",
      "repo": "operations",
      "role": "resource admission/ledger/reconcile",
      "paths": [
        "private/durable_resource_ledger.py",
        "private/durable_resource_contract.py",
        "private/resource_governance_window.py",
        "private/resource_governance_scheduler.py"
      ]
    },
    {
      "id": "operations.governance",
      "repo": "operations",
      "role": "AI/model/tooling policy",
      "paths": [
        "private/language_governance_policy.py",
        "private/runtime_language_policy.py",
        "docs/AI_GOVERNANCE_STANDARD.md"
      ]
    },
    {
      "id": "operations.runtime",
      "repo": "operations",
      "role": "private orchestration/recovery/verification",
      "paths": [
        "worker.py",
        "private/control_plane_diagnostics.py",
        "private/queue_job.py",
        "private/provider_runtime.py"
      ]
    },
    {
      "id": "family.ci",
      "repo": "foundation",
      "role": "GitHub Actions/deployment/backup orchestration",
      "paths": [
        ".github/workflows/heroic-ai-production-release.yml",
        ".github/workflows/nightly-multi-agent-research-v3.yml",
        ".github/workflows/nightly-ai-research-20jobs.yml",
        ".github/workflows/autonomous-benchmark.yml"
      ]
    },
    {
      "id": "family.observability",
      "repo": "foundation+operations",
      "role": "metrics/logs/events/traces/evidence",
      "paths": [
        "docs/runtime-evidence-ownership.md",
        "docs/AI_AUDIT_AND_VERIFICATION_STANDARD.md"
      ]
    }
  ],
