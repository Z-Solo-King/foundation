{
  "schema_version": "public-surface-policy/v2",
  "fail_patterns": [
    "legacy private Worker identities",
    "live custom-domain identifier",
    "live Workers.dev origin",
    "privileged Cloudflare account role",
    "Cloudflare account identifier",
    "D1 identifier",
    "Cloudflare version/deployment identifier",
    "private Operations deployment provenance",
    "private Operations revision disclosure",
    "private revision configuration",
    "live D1 operational counts",
    "Cloudflare nameserver disclosure",
    "Worker edge-address disclosure",
    "private key material",
    "GitHub credential material",
    "live feed target URL in public recovery record",
    "forbidden-public-target-surface"
  ],
  "warn_patterns": [
    "private repository reference",
    "credential identifier"
  ],
  "scanned_documents": [
    "README.md",
    "CHATGPT.md",
    "DEPLOYMENT.md",
    "SECURITY.md",
    "REPOSITORY_MAP.json",
    "docs/**/*.md",
    "docs/**/*.json"
  ],
  "metadata_surfaces": [
    "pull_request.title",
    "pull_request.body",
    "commit.subjects"
  ],
  "authority": "Foundation public security boundary; private runtime authority remains in Operations.",
  "revalidated_at": "2026-09-27",
  "deep_scan_contract": "Operations #1103 public-surface audit",
  "forbidden_public_target_surfaces": [
    "tools/woocommerce_google_feed_*.mjs",
    "tools/custom_api_google_feed_*.mjs",
    "data/feed_lab/custom_api_google_feed_registry_*.json",
    ".github/workflows/woocommerce-google-feed-recovery-*.yml",
    ".github/workflows/custom-api-google-feed-recovery-*.yml"
  ],
  "scan_contract": {
    "implementation": "tools/public_surface_scan.py",
    "recursion": true,
    "public_doc_extensions": [
      ".md",
      ".json"
    ],
    "pr_metadata": [
      "title",
      "body",
      "commits"
    ],
    "target_inventory_policy": "live retailer target registries and recovery tooling belong on private Operations",
    "redaction_policy": "live infrastructure identifiers remain redacted even when previously observed"
  }
}
