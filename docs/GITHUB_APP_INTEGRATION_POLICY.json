{
  "schema_version": "github-app-integration-policy/v2",
  "updated_on": "2026-10-01",
  "marketplace_installation_default": "disabled",
  "installation_requires_explicit_approval": true,
  "allowed_repository_scope": [
    "Z-Solo-King/foundation",
    "Z-Solo-King/operations"
  ],
  "external_marketplace_apps": [],
  "required_controls": {
    "minimum_repository_permissions": true,
    "selected_repository_access": true,
    "short_lived_installation_tokens": true,
    "token_revocation_or_expiry": true,
    "webhook_secret_if_webhooks_are_used": true,
    "minimum_webhook_events": true,
    "audit_receipt_for_privileged_actions": true,
    "no_production_deploy_authority": true,
    "no_secret_mutation_authority": true
  },
  "permission_baseline": {
    "contents": "read",
    "issues": "read",
    "pull_requests": "read",
    "actions": "read"
  },
  "higher_permissions_require": [
    "documented_functional_need",
    "code_review",
    "deterministic_policy_test",
    "live_runtime_evidence",
    "rollback_path"
  ],
  "app_roles": {
    "security": "research_only",
    "code_review": "research_only",
    "ai_agent": "research_only",
    "project_management": "research_only",
    "observability": "research_only",
    "deployment": "forbidden",
    "production_authority": "forbidden"
  },
  "webhook_policy": {
    "enabled_by_default": false,
    "allowed_events": [
      "issues",
      "issue_comment",
      "pull_request",
      "pull_request_review",
      "workflow_run"
    ],
    "signature_validation_required": true,
    "https_required": true
  },
  "provenance": {
    "marketplace_is_discovery_only": true,
    "app_installation_is_not_runtime_authority": true,
    "third_party_apps_must_not_override_canonical_foundation_workflows": true
  },
  "zero_cost_policy": {
    "max_additional_cost_usd": 0,
    "paid_plans_allowed": false,
    "free_trials_allowed": false,
    "payment_method_required": false,
    "external_billing_dependency_allowed": false
  },
  "integration_contract": {
    "external_marketplace_installation": "disabled",
    "external_apps_are_discovery_inputs_only": true,
    "known_first_party_apps": {
      "operations_repository_access": {
        "type": "first_party_github_app",
        "marketplace_app": false,
        "purpose": "private Operations repository read access from Foundation-owned workflows",
        "installation_account": "Z-Solo-King",
        "repository_scope": [
          "Z-Solo-King/operations"
        ],
        "minimum_permissions": {
          "contents": "read"
        },
        "maximum_permissions": {
          "contents": "read"
        },
        "token_max_ttl_seconds": 3600,
        "token_scope_must_be_explicit": true,
        "forbidden_authorities": [
          "production_deploy",
          "secret_mutation",
          "repository_admin",
          "workflow_write",
          "branch_protection_write"
        ],
        "credential_names": [
          "OPERATIONS_APP_ID",
          "OPERATIONS_APP_PRIVATE_KEY"
        ]
      }
    },
    "forbidden_external_capabilities": [
      "production_deploy",
      "secret_mutation",
      "repository_administration",
      "workflow_write",
      "branch_protection_write",
      "permission_escalation",
      "billing_or_payment",
      "unbounded_repository_access"
    ],
    "future_integration_receipt_required_fields": [
      "app_name",
      "app_type",
      "installation_account",
      "installation_id_redacted_or_reference",
      "repository_scope",
      "requested_permissions",
      "effective_permissions",
      "webhook_events",
      "token_expiry",
      "policy_decision",
      "evidence_digest",
      "rollback_reference"
    ],
    "runtime_app_token_rules": {
      "must_use_short_lived_installation_tokens": true,
      "maximum_token_ttl_seconds": 3600,
      "must_scope_repository_explicitly": true,
      "must_request_minimum_permissions": true,
      "must_not_use_user_authorization_for_automation": true
    }
  }
}
