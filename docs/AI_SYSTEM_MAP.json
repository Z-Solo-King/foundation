{
  "schema_version": "ai-system-map/v1",
  "generated_at": "2026-10-01",
  "visibility": "public-safe",
  "purpose": "Unified navigation map for humans and AI agents across Foundation and Operations.",
  "status": "canonical_navigation_overlay",
  "supersedes_as_navigation_entrypoint": [
    "foundation/docs/AI_PROJECT_MAP.json",
    "operations/docs/AI_PROJECT_MAP.json"
  ],
  "source_authorities": {
    "improvement_matrix": "docs/PROJECT_IMPROVEMENT_MATRIX.json",
    "integration_contract": "docs/SYSTEM_INTEGRATION_CONTRACT.json",
    "observability_contract": "docs/PROJECT_OBSERVABILITY_CONTRACT.json",
