  },
  "navigation_algorithm": [
    "classify user/task intent",
    "select one or more functional planes",
    "select canonical component",
    "resolve owner",
    "open most-specific canonical path",
    "read governing policy/contract",
    "locate tests and workflow",
    "inspect evidence tier",
    "inspect live runtime only when required"
  ],
  "navigation_rules": {
    "purpose_over_filetype": true,
    "most_specific_path_wins": true,
    "ownership_is_separate_from_category": true,
    "categories_may_overlap": true,
    "unknown_is_not_zero": true,
    "ai_output_is_not_evidence_authority": true,
    "scores_are_descriptive_unless_canonical_authority_says_otherwise": true,
    "retired_extractor_mapper_repository_is_not_a_runtime_destination": true
  },
  "repositories": {
    "foundation": {
      "owner": "Foundation",
      "role": "public-safe contracts/core, public ingress/frontend, GitHub Actions, deployment orchestration, deterministic mapper core",
