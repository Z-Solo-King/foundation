{
  "schema_version": "code-doc-sync/v1",
  "repository": "Z-Solo-King/foundation",
  "groups": [
    {
      "id": "hygiene-governance",
      "code_paths": [
        "tools/repository_hygiene.py",
        "tools/code_documentation_sync.py",
        ".editorconfig",
        ".gitattributes",
        ".prettierrc.json",
        ".prettierignore",
        ".markdownlint.json",
        "pyproject.toml",
        ".github/pull_request_template.md",
        ".github/workflows/repository-hygiene.yml",
        ".github/workflows/family-hygiene-sync.yml"
      ],
      "docs": [
        "docs/REPOSITORY_HYGIENE_AND_FORMAT_STANDARD.md",
        "docs/REPOSITORY_HYGIENE_FORMAT_CONTRACT.json",
        "docs/CODE_DOCUMENTATION_SYNC_MAP.json"
      ],
      "require_doc_update": true
    },
    {
      "id": "runtime-boundary",
      "code_paths": [
        "edge.ts",
        "worker.py",
        "wrangler.toml",
        "wrangler.python-core.toml",
        "scripts/production_release.sh"
      ],
      "docs": [
