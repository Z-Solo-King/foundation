        "docs/FAMILY_SYNC_STATE.json",
        "docs/AI_SYSTEM_MAP.json",
        "docs/AI_SYSTEM_DIRECTORY.md"
      ],
      "docs": [
        "docs/FAMILY_SYNC_STANDARD.md",
        "docs/CURRENT_SOURCE_OF_TRUTH.md"
      ],
      "require_doc_update": true
    },
    {
      "id": "feed-recovery-contract",
      "code_paths": [
        ".github/workflows/woocommerce-*.yml",
        "scripts/*feed*.py",
        "scripts/*feed*.sh",
        "tools/*feed*.py"
      ],
      "docs": [
        "docs/WOOCOMMERCE_GOOGLE_FEED_RECOVERY_1247.md",
        "docs/DOCUMENTATION_INDEX.md"
      ],
      "require_doc_update": true
    },
    {
      "id": "autonomous-governance",
      "code_paths": [
        "tools/autonomous_engineering_supervisor.mjs",
        "tools/autonomous_mission_router.mjs",
        "tests/autonomous_engineering_supervisor.test.mjs",
        "tests/autonomous_mission_router.test.mjs",
        ".github/workflows/twice-daily-governance-sweep.yml",
        ".github/workflows/repository-hygiene-autofix.yml",
        "docs/PROJECT_IMPROVEMENT_MATRIX.json",
        "docs/SYSTEM_INTEGRATION_CONTRACT.json",
        "docs/WORKFLOW_AUTHORITY_REGISTRY.json",
        "tools/comprehensive_governance_scan.py",
        "tools/publish_governance_findings.py",
        "tests/test_comprehensive_governance_scan.py",
        "scripts/validate_github_app_policy.py",
        "tests/test_github_app_marketplace_policy.py",
        "docs/GITHUB_APP_INTEGRATION_POLICY.json"
      ],
      "docs": [
        "docs/AI_AUDIT_SYSTEM.md",
        "docs/PROJECT_IMPROVEMENT_MATRIX.json",
        "docs/SYSTEM_INTEGRATION_CONTRACT.json",
        "docs/PRIVILEGED_WORKFLOW_TRUST_BOUNDARY.md",
        "docs/FAMILY_SYNC_STANDARD.md",
        "docs/AUTONOMOUS_GOVERNANCE_SCAN_CONTRACT.json",
        "docs/AI_SYSTEM_MAP.json",
        "docs/GITHUB_APP_INTEGRATION_POLICY.json"
      ],
      "require_doc_update": true
    }
