{
  "schema": "engineering-crossfire-profile/v1",
  "authority": "diagnostic_only",
  "max_lanes": 6,
  "required_lanes": [
    "ownership",
    "contracts",
    "workflows",
    "language",
    "documentation",
    "public-surface"
  ],
  "parallel": {
    "mode": "bounded_independent",
    "shared_lane_feedback": false,
    "serialize_mutations": true
  },
  "evidence_thresholds": {
    "full_6": 6,
    "strong_5": 5,
    "limited_min": 2,
    "insufficient_max": 1
  },
  "token_efficiency": {
    "prefer_structured_findings": true,
    "retain_raw_transcripts": false,
    "retain_response_digests": true
  },
  "private_repo_scan": {
    "optional": true,
    "purpose": "cross-repository ownership and workflow consistency",
    "canonical_owner": "Foundation hosted CI"
  }
}
