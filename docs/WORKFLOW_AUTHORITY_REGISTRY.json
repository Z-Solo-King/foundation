    [".github/workflows/browser-engine-runtime-evidence.yml","private_benchmark"],
    [".github/workflows/canonical-nightly-pin-repair.yml","revision_maintenance"],
    [".github/workflows/commerce-feed-product-crawl.yml","private_registry_feed_crawl"],
    [".github/workflows/coverage-driven-runtime-matrix.yml","runtime_matrix"],
    [".github/workflows/cross-repository-contract-drift.yml","private_audit"],
    [".github/workflows/exhaustive-six-lane-audit.yml","private_audit"],
    [".github/workflows/extractor-surface-governance.yml","private_audit"],
    [".github/workflows/family-integrity-gate.yml","family_governance"],
    [".github/workflows/heroic-ai-production-release.yml","production_deployment"],
    [".github/workflows/hybrid-language-pilots.yml","private_benchmark"],
    [".github/workflows/live-ai-agent-benchmark.yml","live_benchmark"],
    [".github/workflows/live-chatbot-production-smoke.yml","private_production_smoke"],
    [".github/workflows/live-extractor-benchmark.yml","live_extractor_benchmark"],
    [".github/workflows/live-nightly-research-canary.yml","private_research_canary"],
    [".github/workflows/nightly-multi-agent-research-v3.yml","research_public_frontdoor"],
    [".github/workflows/nightly-research-provider-preflight.yml","private_research_preflight"],
    [".github/workflows/observation-contract-shadow.yml","private_benchmark"],
    [".github/workflows/open-issue-polyglot-deep-scan.yml","private_audit"],
    [".github/workflows/operations-centralized-validation.yml","private_validation"],
    [".github/workflows/polyglot-governance-audit.yml","private_audit"],
    [".github/workflows/polyglot-migration-review.yml","private_benchmark"],
    [".github/workflows/provider-fleet-runtime-state.yml","private_runtime_state"],
    [".github/workflows/sync-secrets.yml","secret_sync"],
    [".github/workflows/woocommerce-v175-22-plugin-extraction.yml","private_feed_extraction"]
  ],
  "policy": {
    "privileged_markers": [
      "secrets.",
      "actions/create-github-app-token",
      "Z-Solo-King/operations",
      "OPERATIONS_APP_ID",
      "OPERATIONS_APP_PRIVATE_KEY",
      "operations-app.outputs.token"
    ],
    "forbidden_events": [
      "pull_request",
      "pull_request_target",
      "merge_group"
    ],
    "privileged_push_branch": "main",
    "principle": "workflow authority is a machine-enforced boundary; documentation alone is insufficient",
    "trusted_workflow_run_sources": {
      ".github/workflows/live-nightly-research-canary.yml": [
        "nightly multi-agent research"
      ]
    }
  }
}
