{
  "schema_version": "repository-map/v1",
  "repository": "Z-Solo-King/foundation",
  "role": "public_product_boundary_for_heroic_ai",
  "product": "Heroic AI",
  "read_first": [
    "docs/HEROIC_AI_PRODUCT.md",
    "README.md",
    "docs/DOCUMENTATION_INDEX.md",
    "docs/FAMILY_CONTRACT.json",
    "docs/FAMILY_ARCHITECTURE.md",
    "docs/FAMILY_INTEGRATION_GRAPH.json",
    "Z-Solo-King/operations:docs/CURRENT_SOURCE_OF_TRUTH.md"
  ],
  "canonical": {
    "chat_product_ui": "frontend/index.html",
    "chat_frontend_lifecycle": "frontend/app.js",
    "research_lifecycle": "frontend/lifecycle_controller.js",
    "public_chat_contract_module": "backend/api/models.py",
    "public_worker_chat_boundary": "worker.py",
    "public_research_api": "backend/api/main.py",
    "request_model": "backend/api/models.py",
    "product_identity": "foundation_core/product_identity.py",
    "product_mapping": "foundation_core/product_mapping.py",
    "normalization": "foundation_core/normalization.py",
    "field_routing": "foundation_core/field_routing.py",
    "evidence_certificates": "backend/evidence_certificate.py",
    "evidence_selection": "backend/evidence_selection.py",
    "claims": "backend/intelligence/claims.py",
    "execution": "backend/execution/engine.py",
    "research_pipeline": "backend/execution/pipeline.py",
    "public_worker_boundary": "backend/execution/worker_boundary.py",
    "artifacts": "backend/artifacts/manifest.py",
    "benchmarks": "benchmark/",
    "family_integration_graph": "docs/FAMILY_INTEGRATION_GRAPH.json",
    "family_integration_architecture": "docs/FAMILY_INTEGRATION_ARCHITECTURE_2026-09-25.md"
  },
  "boundary": {
    "private_operations": "Z-Solo-King/operations",
    "foundation_must_not_import_private_runtime": true,
    "public_safe_only": true,
    "private_user_memory_is_external": true,
    "protected_policy_is_external": true,
    "heroic_ai_is_the_user_facing_product": true,
    "research_is_a_heroic_ai_capability": true
  },
  "maintenance": {
    "validation_workflow": ".github/workflows/required-pr-checks.yml",
    "public_tests": "tests/",
    "deployment_workflow": ".github/workflows/heroic-ai-production-release.yml",
    "historical_code_is_not_runtime": true,
    "github_actions_owner": ".github/workflows/",
    "private_operations_actions_forbidden": true,
    "private_operations_access": "Foundation GitHub App short-lived installation token",
    "workflow_dispatch_bridge": ".github/workflows/foundation-canonical-workflow-bridge-v3.yml",
    "private_runtime_actions_route": ".github/workflows/foundation-canonical-workflow-bridge-v3.yml",
    "private_runtime_must_not_dispatch_targets_directly": true,
    "foundation_app_dispatch_targets": [
      ".github/workflows/nightly-multi-agent-research-v3.yml",
      ".github/workflows/heroic-ai-production-release.yml",
      ".github/workflows/cross-repository-contract-drift.yml",
      ".github/workflows/operations-centralized-validation.yml",
      ".github/workflows/main-push-actions-control-plane-probe-v2.yml"
    ],
    "family_sync_state": "docs/FAMILY_SYNC_STATE.json"
  },
  "method": [
    "accept Heroic AI request",
    "authenticate and route through public/private boundary",
    "classify chat/research capability",
    "reserve governed resources",
    "acquire/observe permitted evidence when required",
    "deterministically extract/map/verify",
    "produce grounded response state",
    "publish citations/uncertainty",
    "persist only through the owning boundary"
  ],
  "operations_use": "Operations is the private control plane for Heroic AI. It consumes Foundation contracts and public-safe results; it does not copy Foundation implementation authority. Operations contains no GitHub Actions workflows; all family automation is owned by Foundation."
}
